    # ========================================================

    pivot = sensitivity_df.pivot(
        index="threshold",
        columns="learning_rate",
        values="mean_polarization"
    )

    plt.figure(figsize=(9, 6))

    sns.heatmap(
        pivot,
        annot=True,
